# Copy this file to .env for a local deployment.
COMPOSE_PROJECT_NAME=kitsu-docker-main

DOCKER_HOST_IP=127.0.0.1
DOMAIN_PROTOCOL=http
KITSU_WEB_HOST_PORT=8080
ZOU_API_HOST_PORT=5001
ZOU_API_INTERNAL_PORT=8000
ZOU_EVENTS_INTERNAL_PORT=5001
KITSU_WEB_URL=http://${DOCKER_HOST_IP}:${KITSU_WEB_HOST_PORT}
ZOU_API_URL=http://${DOCKER_HOST_IP}:${ZOU_API_HOST_PORT}

KITSU_DOMAIN=localhost
KITSU_WEB_HOST=${KITSU_DOMAIN}
LETSENCRYPT_EMAIL=admin@example.com

POSTGRES_USER=kitsu
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kitsu

REDIS_PORT=6379
ZOU_SECRET_KEY=change-me-generate-a-long-random-value
ZOU_ADMIN_EMAIL=${LETSENCRYPT_EMAIL}
ZOU_ADMIN_PASSWORD=change-me
ZOU_ALLOWED_HOSTS=*
ZOU_LOG_LEVEL=info
REDIS_URL=redis://redis:6379/0
ENABLE_JOB_QUEUE=True
JOB_QUEUE_TIMEOUT=3600
PREVIEW_FOLDER=/opt/zou/previews
TMP_DIR=/tmp/zou

TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443

MEILI_PORT=7700
MEILI_MASTER_KEY=change-me-generate-a-long-random-value

MAILCATCHER_HTTP_PORT=1080
MAILCATCHER_SMTP_PORT=1025

BACKUP_CRON=30 1 * * *
BACKUP_RETENTION_DAYS=14
PREVIEW_BACKUP_RETENTION_DAYS=14
